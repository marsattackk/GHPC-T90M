{"name":"PDT back-up sight (T-90M)","fov":3.0,"units":"mrad","lights":{"from_host":true},"style":{"visual":"painted","light":"NightIllumination"},"vars":{"Hm":"Fov * PI / 0.18","Mil":"PI / 3","Arm":"0.1765 * Hm","StrokeLen":"0.0744 * Hm","W":"0.0079 * Hm","Base":2370,"Sx":"0.36 * Hm","Sy":"-0.08 * Hm","Pic":"2.55 / 3.0"},"elements":[{"group":"Mark","align":"Impact","elements":[{"seg":["-Arm",0,"Arm",0],"w":"W"},{"seg":[0,"-0.104 * Hm",0,"0.0975 * Hm"],"w":"W"},{"seg":[0,"0.1146 * Hm",0,"0.1515 * Hm"],"w":"W"},{"seg":[0,"-0.1206 * Hm",0,"-0.1594 * Hm"],"w":"W"},{"seg":["-(Arm + Mil)",0,"-(Arm + Mil + StrokeLen)",0],"w":"W"},{"seg":["Arm + Mil",0,"Arm + Mil + StrokeLen",0],"w":"W"}]},{"group":"Stadia","align":"Boresight","elements":[{"seg":["Sx","Sy","Sx + 0.06 * Hm","Sy"],"w":0.2},{"seg":["Sx","Sy","Sx","Sy + Base / 500"],"w":0.12},{"for":"r","in":[500,1000,1500,2000,3000],"do":[{"seg":["Sx","Sy + Base / r","Sx + (r % 1000 == 0 ? 0.04 : 0.025) * Hm","Sy + Base / r"],"w":0.12}]}]}],"screen":{"name":"PDT monitor","items":[{"rect":"monitor edge","at":["-(2 / 3 + 1) * Hm",0],"size":["2 * Hm","1.02 * Hm"],"color":[0,0,0,1]},{"rect":"monitor edge","at":["(2 / 3 + 1) * Hm",0],"size":["2 * Hm","1.02 * Hm"],"color":[0,0,0,1]},{"rect":"picture band","at":[0,"(Pic / 2 + 0.5) * Hm"],"size":["2 * Hm","1.0 * Hm"],"color":[0,0,0,1]},{"rect":"picture band","at":[0,"-(Pic / 2 + 0.5) * Hm"],"size":["2 * Hm","1.0 * Hm"],"color":[0,0,0,1]}]}}